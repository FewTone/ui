{
  "name": "fewtone-ui",
  "private": true,
  "description": "FewTone UI: accessible, customizable React components for Next.js and Tailwind CSS.",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "index": "node scripts/build-index.mjs",
    "check:index": "node scripts/build-index.mjs --check",
    "tokens": "node scripts/tokens/generate-palette.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check": "pnpm lint && pnpm check:index && pnpm typecheck && pnpm check:tokens && pnpm test",
    "deploy:preview": "node scripts/deploy.mjs",
    "deploy:prod": "node scripts/deploy.mjs --prod",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "turbo": "^2.11.7"
  }
}
