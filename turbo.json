{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/ui/src/**", "$TURBO_ROOT$/scripts/**"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "public/r/**"],
      "env": ["REGISTRY_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["REGISTRY_URL"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    }
  }
}
